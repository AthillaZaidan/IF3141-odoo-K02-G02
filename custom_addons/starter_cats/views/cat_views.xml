<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="starter_cat_view_tree" model="ir.ui.view">
        <field name="name">starter.cat.tree</field>
        <field name="model">starter.cat</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="cat_type_id"/>
                <field name="birth_date"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="starter_cat_view_form" model="ir.ui.view">
        <field name="name">starter.cat.form</field>
        <field name="model">starter.cat</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Tombol memanggil method model; invisible mengikuti state. -->
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_set_archived" type="object" string="Archive"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="cat_type_id"/>
                        <field name="birth_date"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="starter_cat_view_search" model="ir.ui.view">
        <field name="name">starter.cat.search</field>
        <field name="model">starter.cat</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="cat_type_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Type" context="{'group_by': 'cat_type_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="starter_cat_action" model="ir.actions.act_window">
        <field name="name">Cats</field>
        <field name="res_model">starter.cat</field>
        <field name="view_mode">tree,form</field>
        <!-- help ditampilkan saat daftar kosong (empty state). -->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first cat</p>
            <p>Create a cat, then activate it to start tracking it.</p>
        </field>
    </record>
</odoo>
