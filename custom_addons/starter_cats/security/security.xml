<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kategori + dua group; manager mewarisi hak user lewat implied_ids. -->
    <record id="module_category_starter_cats" model="ir.module.category">
        <field name="name">Starter Cats</field>
        <field name="sequence">100</field>
    </record>

    <record id="group_cat_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_starter_cats"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_cat_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_starter_cats"/>
        <field name="implied_ids" eval="[(4, ref('group_cat_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record rule: user hanya melihat kucing buatannya; manager melihat semua. -->
    <record id="rule_cat_user_own" model="ir.rule">
        <field name="name">Cat: user sees own records</field>
        <field name="model_id" ref="model_starter_cat"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_cat_user'))]"/>
    </record>

    <record id="rule_cat_manager_all" model="ir.rule">
        <field name="name">Cat: manager sees all</field>
        <field name="model_id" ref="model_starter_cat"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_cat_manager'))]"/>
    </record>
</odoo>
