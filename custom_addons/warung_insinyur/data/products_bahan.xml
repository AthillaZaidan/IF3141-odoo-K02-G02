    <record id="bhn_indomie_goreng" model="product.template">
        <field name="name">Mi Instan Indomie Goreng (bungkus)</field>
        <field name="default_code">BHN-001</field>
        <field name="detailed_type">product</field>
        <field name="categ_id" ref="categ_bahan"/>
        <field name="uom_id" ref="uom.product_uom_unit"/>
        <field name="uom_po_id" ref="uom.product_uom_unit"/>
        <field name="standard_price">3000</field>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="True"/>
        <field name="route_ids" eval="[(6, 0, [ref('purchase_stock.route_warehouse0_buy')])]"/>
        <field name="seller_ids" eval="[(0, 0, {'partner_id': ref('partner_supplier_grup_hotel'), 'price': 3000, 'min_qty': 1})]"/>
